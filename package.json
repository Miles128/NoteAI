{
  "name": "noteai",
  "version": "0.1.0",
  "description": "**AI 驱动的个人知识库 + AI 助手桌面应用** — 采集、整理、链接、检索、对话，让零散信息生长为结构化知识，让 AI 助手基于你的知识库回答问题。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:tiptap": "node scripts/build-tiptap-bundle.mjs",
    "build:mcp": "node scripts/build-mcp-bundle.mjs",
    "build:webui": "node scripts/build-webui.mjs",
    "build:webui:min": "node scripts/build-webui.mjs --minify",
    "build:highlight": "node scripts/build-highlight.mjs",
    "dev:webui": "node scripts/build-webui.mjs --watch",
    "build:desktop": "npm run build:tiptap && node scripts/bundle-mcp-runtime.mjs",
    "test": "node --test mcp-server/test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "punycode": "^2.3.1",
    "tiptap-markdown": "^0.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "highlight.js": "^11.12.0"
  }
}
